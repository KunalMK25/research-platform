# ─────────────────────────────────────────────────────────────────────────────
# VERITY AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ─────────────────────────────────────────────────────────────────────────────

# --- Backend Core Credentials ---
# Groq API Key for Swarm Agent reasoning (planner, verifier, synthesizer, reporter)
GROQ_API_KEY=gsk_...

# Tavily Search API Key for researcher agent searches
TAVILY_API_KEY=tvly-...

# --- Database & Storage Configuration ---
# SQLAlchemy Async Database Connection String (SQLite is default)
DATABASE_URL=sqlite+aiosqlite:///./research.db

# Chroma DB Vector database local persistence storage folder
CHROMA_PERSIST_PATH=./chroma_data

# --- Frontend Connection Parameters ---
# The backend FastAPI server url endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- Firebase Client Authentication Credentials ---
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=verity-ai.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=verity-ai
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=verity-ai.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
